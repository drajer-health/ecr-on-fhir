<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>

        <!--
            SECURITY UPDATE:
            3.3.4 was flagged for CVE-2026-40973.
            Staying on Spring Boot 3.x avoids a Boot 4 migration.
        -->
        <version>3.5.16</version>

        <relativePath/>
    </parent>

    <groupId>com.drajer</groupId>
    <artifactId>fhirvalidator</artifactId>
    <version>0.0.4-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>fhirvalidator</name>
    <description>EICR FHIR Validator</description>

    <properties>

        <java.version>17</java.version>

        <!-- Keep HAPI FHIR unchanged for this remediation pass -->
        <fhir.version>7.0.2</fhir.version>

        <!-- Security remediation versions -->
        <jackson.version>2.21.4</jackson.version>
        <thymeleaf.version>3.1.5.RELEASE</thymeleaf.version>
        <nimbus.version>9.37.4</nimbus.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <ucum.version>1.0.10</ucum.version>

    </properties>


    <!--
        SECURITY DEPENDENCY OVERRIDES

        Several vulnerable libraries are brought into the WAR transitively
        by HAPI / HL7 dependencies.

        dependencyManagement allows us to force secure versions without
        unnecessarily changing the HAPI FHIR version.
    -->
    <dependencyManagement>
        <dependencies>

            <!--
                Keep ALL Jackson 2.x modules on the same version.

                Fixes jackson-core findings including:
                GHSA-72hv-8253-57qq
                GHSA-r7wm-3cxj-wff9
            -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>


            <!--
                Fixes Thymeleaf vulnerabilities including:
                CVE-2026-40477
                CVE-2026-40478
                CVE-2026-41901
            -->
            <dependency>
                <groupId>org.thymeleaf</groupId>
                <artifactId>thymeleaf</artifactId>
                <version>${thymeleaf.version}</version>
            </dependency>


            <!--
                Fixes Nimbus vulnerabilities:
                CVE-2023-52428
                CVE-2025-53864

                9.37.4 avoids unnecessary migration to Nimbus 10.x.
            -->
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus.version}</version>
            </dependency>


            <!--
                Fixes Commons Compress:
                CVE-2024-25710
                CVE-2024-26308
            -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>


    <dependencies>

        <!-- ========================================================= -->
        <!-- FHIR DEPENDENCIES                                         -->
        <!-- ========================================================= -->

        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-structures-r4</artifactId>
            <version>${fhir.version}</version>
        </dependency>

        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-structures-r5</artifactId>
            <version>${fhir.version}</version>
        </dependency>

        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-validation-resources-r4</artifactId>
            <version>${fhir.version}</version>
        </dependency>

        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-validation-resources-r5</artifactId>
            <version>${fhir.version}</version>
        </dependency>

        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-base</artifactId>
            <version>${fhir.version}</version>
        </dependency>

        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-server</artifactId>
            <version>${fhir.version}</version>
        </dependency>

        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-client</artifactId>
            <version>${fhir.version}</version>
        </dependency>


        <!-- ========================================================= -->
        <!-- HL7 FHIR CORE VALIDATOR                                   -->
        <!-- ========================================================= -->

        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>org.hl7.fhir.validation</artifactId>
            <version>6.1.16</version>

            <exclusions>

                <exclusion>
                    <groupId>info.cqframework</groupId>
                    <artifactId>cql</artifactId>
                </exclusion>

                <exclusion>
                    <groupId>info.cqframework</groupId>
                    <artifactId>model</artifactId>
                </exclusion>

                <exclusion>
                    <groupId>info.cqframework</groupId>
                    <artifactId>elm</artifactId>
                </exclusion>

                <exclusion>
                    <groupId>info.cqframework</groupId>
                    <artifactId>cql-to-elm</artifactId>
                </exclusion>

                <exclusion>
                    <groupId>info.cqframework</groupId>
                    <artifactId>quick</artifactId>
                </exclusion>

                <exclusion>
                    <groupId>info.cqframework</groupId>
                    <artifactId>qdm</artifactId>
                </exclusion>

                <!--
                    Retaining these exclusions because Jackson
                    is explicitly managed below.
                -->
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                </exclusion>

                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </exclusion>

            </exclusions>

        </dependency>


        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>org.hl7.fhir.utilities</artifactId>
            <version>6.1.16</version>
        </dependency>


        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>org.hl7.fhir.r5</artifactId>
            <version>6.1.16</version>
        </dependency>


        <!-- ========================================================= -->
        <!-- SECURITY UPDATED DEPENDENCIES                             -->
        <!-- ========================================================= -->

        <!--
            CVE-2024-55887
            Minimum fixed version: 1.0.9
            Using current 1.0.10.
        -->
        <dependency>
            <groupId>org.fhir</groupId>
            <artifactId>ucum</artifactId>
            <version>${ucum.version}</version>
        </dependency>


        <!--
            Explicit declaration ensures Maven resolves the secure
            transitive Commons Compress version.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>${commons-compress.version}</version>
        </dependency>


        <!--
            Explicit declaration ensures the vulnerable transitive
            Thymeleaf 3.1.2.RELEASE is replaced.
        -->
        <dependency>
            <groupId>org.thymeleaf</groupId>
            <artifactId>thymeleaf</artifactId>
            <version>${thymeleaf.version}</version>
        </dependency>


        <!--
            Explicit declaration ensures Nimbus 9.30.2
            cannot be packaged transitively.
        -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus.version}</version>
        </dependency>


        <!-- ========================================================= -->
        <!-- COMMON UTILITIES                                          -->
        <!-- ========================================================= -->

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.10.0</version>
        </dependency>

        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.0</version>
        </dependency>

        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20230618</version>
        </dependency>


        <!-- ========================================================= -->
        <!-- JACKSON                                                   -->
        <!-- ========================================================= -->

        <!--
            Versions are controlled by Jackson BOM above.
            Do NOT specify individual versions here.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>


        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.13.0</version>
        </dependency>


        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.10.0</version>
        </dependency>


        <!-- ========================================================= -->
        <!-- SPRING SUPPORT                                            -->
        <!-- ========================================================= -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>


        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!--
            Correct for deployment as WAR into an external Tomcat.
            Tomcat libraries should not be bundled under WEB-INF/lib.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <build>

        <finalName>${project.artifactId}</finalName>

        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>

    </build>

</project>